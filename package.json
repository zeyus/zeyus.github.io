{
	"name": "zeyus",
	"version": "1.4.0",
	"private": true,
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite dev --host",
		"build": "vite build",
		"images": "node scripts/images.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gh-pages": "pnpm run build && pnpm exec gh-pages --nojekyll -d build -t"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@floating-ui/dom": "^1.8.0",
		"@material/typography": "^14.0.0",
		"@svelte-put/preprocess-auto-slug": "^2.0.0",
		"@svelte-put/toc": "^6.0.2",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/w3c-web-serial": "^1.0.9",
		"@types/w3c-web-usb": "^1.0.14",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-unicode11": "^0.9.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"gh-pages": "^6.3.0",
		"globals": "^17.14.0",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.1.0",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"svader": "^1.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"util": "^0.12.5",
		"vite": "^8.3.8",
		"vite-plugin-mkcert": "^2.1.0",
		"vitest": "^4.1.12"
	},
	"type": "module",
	"dependencies": {
		"svelte-highlight": "^7.23.2"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"pnpm": ">=10",
		"node": ">=24"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#components/*": "./src/components/*"
	}
}
