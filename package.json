{
	"name": "zeyus",
	"version": "1.4.0",
	"private": true,
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite dev --host",
		"build": "vite build",
		"images": "node scripts/images.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gh-pages": "pnpm run build && pnpm exec gh-pages --nojekyll -d build -t"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@floating-ui/dom": "^1.8.0",
		"@material/typography": "^14.0.0",
		"@svelte-put/preprocess-auto-slug": "^2.0.0",
		"@svelte-put/toc": "^6.0.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/w3c-web-serial": "^1.0.8",
		"@types/w3c-web-usb": "^1.0.14",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-unicode11": "^0.9.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"autoprefixer": "^10.6.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"gh-pages": "^6.3.0",
		"globals": "^17.13.0",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.1.0",
		"postcss": "^8.5.28",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"svader": "^1.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"util": "^0.12.5",
		"vite": "^8.3.2",
		"vite-plugin-mkcert": "^2.1.0",
		"vitest": "^4.1.11"
	},
	"type": "module",
	"dependencies": {
		"svelte-highlight": "^7.22.0"
	},
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"pnpm": ">=10",
		"node": ">=24"
	}
}
